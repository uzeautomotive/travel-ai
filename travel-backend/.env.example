# PostgreSQL холболт: postgresql://ХЭРЭГЛЭГЧ:НУУЦ_ҮГ@ХОСТ:ПОРТ/travel
DATABASE_URL=
# Зөвшөөрөх frontend хаягууд, таслалаар тусгаарлана
ALLOWED_ORIGINS=
# ML загварын файлын зам (main.py-тэй харьцуулсан эсвэл бүтэн зам)
MODEL_PATH=
# Токен гарын үсгийн нууц түлхүүр (урт, санамсаргүй тэмдэгт мөр)
JWT_SECRET=
# Токены хүчинтэй хугацаа (минутаар)
JWT_EXPIRE_MINUTES=60
